# Copy to ~/.config/hacklaw/lexora.env (never commit the real file)
MISTRAL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# comma-separated, e.g. whatsapp:+33612345678,whatsapp:+33698765432 (demo phones only)
LEXORA_ALLOWED_NUMBERS=
# public ngrok URL, used to verify Twilio signatures
LEXORA_PUBLIC_URL=
# Légifrance + Judilibre via PISTE (piste.gouv.fr), prod or sandbox
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_ENV=prod
# HMAC key of the agent journal: generate with `openssl rand -hex 32`, never display it
LEXORA_JOURNAL_KEY=
# a conversation idle longer than this starts a new case
LEXORA_SESSION_HOURS=12
