{
  "name": "lexora-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "typecheck": "tsc --build --force tsconfig.json && tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @lexora/db run db:generate",
    "db:migrate": "pnpm --filter @lexora/db run db:migrate",
    "db:seed": "pnpm --filter @lexora/db run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@lexora/db": "workspace:*",
    "@lexora/shared": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "drizzle-orm": "0.44.6",
    "eslint": "9.39.1",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
