# Copy to `.env` and fill in. `.env` is git-ignored; this example never holds a real secret.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Application connection used by the data service and the seed.
# Matches compose.yaml. Never logged, never printed on validation failure.
DATABASE_URL=postgres://lexora:lexora_local_dev@127.0.0.1:5435/lexora

# Separate schema-migration identity. Locally the same database; in a deployed
# environment this is a distinct, higher-privilege role that request handlers never hold.
MIGRATION_DATABASE_URL=postgres://lexora:lexora_local_dev@127.0.0.1:5435/lexora

# Integration tests create and drop a disposable database, so they need an identity
# allowed to CREATE DATABASE.
TEST_ADMIN_DATABASE_URL=postgres://lexora:lexora_local_dev@127.0.0.1:5435/postgres

# Optional: overrides the seeded fictional hearing instant (ISO 8601, UTC).
# Leave unset for a deterministic fixture; set it for a live demo on a fresh database.
# SEED_HEARING_AT=2026-10-05T08:30:00Z

# Providers. Optional today: nothing in the current code path contacts them, and the
# config parser treats them as optional so a database-only checkout still boots.
MISTRAL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
